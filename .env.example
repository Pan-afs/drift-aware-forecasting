# Copy to .env (make env does this) and fill in the FRED key.

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: Harvard Dataverse API token, only needed if the Telecom Italia
# files require authentication for your account.
DATAVERSE_API_TOKEN=

# ClickHouse (inside compose the host is overridden to "clickhouse")
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=daf
CLICKHOUSE_PASSWORD=daf
CLICKHOUSE_DB=daf

# Airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
